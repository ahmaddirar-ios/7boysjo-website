# Auto detect text files and perform LF normalization
* text=auto

# PHP files
*.php text eol=lf diff=php

# JavaScript
*.js text eol=lf

# CSS
*.css text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf diff=markdown

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.webp binary

# Archives
*.zip binary
*.tar.gz binary
*.gz binary
